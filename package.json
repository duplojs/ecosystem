{
  "name": "duplojs",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "./.commands/build.sh",
    "test:ut": "./.commands/test-ut.sh",
    "test:types": "./.commands/test-types.sh",
    "test:lint": "./.commands/test-lint.sh",
    "remove-modules": "rm -rf node_modules packages/*/node_modules packages/*/integrations/node_modules",
    "remove-dist": "rm -rf packages/*/dist",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duplojs/ecosystem.git"
  },
  "devDependencies": {
    "@duplojs/code-config": "workspace:*",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-istanbul": "5.0.0",
    "husky": "9.1.7",
    "rolldown": "1.2.7",
    "tscw-config": "1.1.2",
    "typescript": "7.0.2",
    "unplugin-dts": "1.1.0",
    "vitest": "5.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
