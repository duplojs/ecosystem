{
  "name": "@duplojs/unplugin-jsdoc-include",
  "version": "0.0.0",
  "author": {
    "name": "DuploJS",
    "url": "https://github.com/duplojs"
  },
  "description": "A universal plugin to inline external files and documentation into JSDoc comments during build",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "./.commands/build.sh",
    "test:types": "./.commands/test-types.sh",
    "test:types:target": "./.commands/test-types-target.sh",
    "test:lint": "./.commands/test-lint.sh",
    "test:lint:fix": "./.commands/test-lint.sh --fix"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "import": "./dist/rolldown.mjs",
      "require": "./dist/rolldown.cjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.mjs",
      "require": "./dist/rollup.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "dependencies": {
    "@duplojs/lang": "workspace:*",
    "@duplojs/server": "workspace:*",
    "unplugin": "3.4.0"
  },
  "devDependencies": {
    "@duplojs/code-config": "workspace:*"
  },
  "files": [
    "dist",
    "README"
  ],
  "keywords": [
    "plugin-rolldown",
    "include-jsdoc",
    "include-comment",
    "duplojs"
  ],
  "engines": {
    "node": ">=24.18.0"
  }
}
