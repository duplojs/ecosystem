// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`newTypeStructureTransformer > renders a new typed business object 1`] = `
{
  "$ref": "#/definitions/Value",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Value": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "format": "email",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "title": "CustomerId",
          "type": "string",
        },
        "status": {
          "anyOf": [
            {
              "const": "active",
              "type": "string",
            },
            {
              "const": "blocked",
              "type": "string",
            },
          ],
        },
        "tags": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S.*\\S$|^\\S$",
            "type": "string",
          },
          "maxItems": 5,
          "type": "array",
        },
      },
      "required": [
        "id",
        "email",
        "status",
        "tags",
      ],
      "title": "CustomerProfile",
      "type": "object",
    },
  },
}
`;

