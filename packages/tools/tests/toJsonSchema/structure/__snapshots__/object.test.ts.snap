        "orders",
        "metadata",
      ],
      "type": "object",
    },
  },
}
`;

exports[`objectStructureTransformer > renders a recursive object tree 1`] = `
{
  "$ref": "#/definitions/Category",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Category": {
      "$ref": "#/definitions/RecursiveName0",
    },
    "RecursiveName0": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/definitions/RecursiveName0",
          },
          "maxItems": 10,
          "type": "array",
        },
        "id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "name": {
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$",
          "type": "string",
        },
      },
      "required": [
        "id",
        "name",
        "children",
      ],
      "type": "object",
    },
  },
}
`;

