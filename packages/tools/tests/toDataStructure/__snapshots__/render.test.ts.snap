exports[`toDataStructure render > applies hooks and import metadata while rendering a shared structure 1`] = `
"import * as DDataStructure from "@duplojs/lang/dataStructure";

import { CatalogMarker } from "@acme/catalog";

export const externalProductDataStructure = DDataStructure.ObjectStructure({ sku: DDataStructure.TypeStructure(DDataStructure.StringType(), [DDataStructure.NotEmptyConstraint()]) }, []);

export const catalogPageDataStructure = DDataStructure.ObjectStructure({ primaryProduct: externalProductDataStructure, secondaryProduct: externalProductDataStructure }, []);"
`;

