exports[`startsWithConstraintTransformer > renders combined constraints on an identified structure 1`] = `
"import * as DDataStructure from "@duplojs/lang/dataStructure";

export const resourcePathStructure = DDataStructure.TypeStructure(DDataStructure.StringType(), [
    DDataStructure.StartsWithConstraint("asset:"),
    DDataStructure.EndsWithConstraint(".json"),
    DDataStructure.IncludeConstraint("/lang/")
]);"
`;
