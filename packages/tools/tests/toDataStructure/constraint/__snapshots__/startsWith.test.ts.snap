exports[`startsWithConstraintTransformer > renders a literal in a nested structure 1`] = `
"import * as DDataStructure from "@duplojs/lang/dataStructure";

export const resourceStructure = DDataStructure.ObjectStructure({
    path: DDataStructure.TypeStructure(DDataStructure.StringType(), [
        DDataStructure.StartsWithConstraint("asset:")
    ])
}, []);"
`;

