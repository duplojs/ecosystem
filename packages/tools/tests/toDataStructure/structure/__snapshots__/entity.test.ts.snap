// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`entityStructureTransformer > propagates an unsupported entity property 1`] = `[Error: Error during the render of dataStructure in dataStructure.]`;

exports[`entityStructureTransformer > renders an order entity with customer and status fields 1`] = `
"import * as DDataStructure from "@duplojs/lang/dataStructure";

import * as DModeling from "@duplojs/lang/modeling";

export const customerIdStructureDataStructure = DModeling.NewTypeStructure("CustomerId", DDataStructure.TypeStructure(DDataStructure.StringType(), [DDataStructure.UuidConstraint()]), []);

export const orderEntityDataStructure = DModeling.EntityStructure("Order", () => ({ id: DModeling.NewTypeStructure("OrderId", DDataStructure.TypeStructure(DDataStructure.StringType(), [DDataStructure.UuidConstraint()]), []), customerId: customerIdStructureDataStructure, status: DDataStructure.UnionStructure([DDataStructure.TypeStructure(DDataStructure.StringLiteralType("draft"), []), DDataStructure.TypeStructure(DDataStructure.StringLiteralType("paid"), []), DDataStructure.TypeStructure(DDataStructure.StringLiteralType("cancelled"), [])], []), invoice: DDataStructure.UnionStructure([DDataStructure.TypeStructure(DDataStructure.UndefinedType(), []), DDataStructure.ObjectStructure({ number: DDataStructure.TypeStructure(DDataStructure.StringType(), [DDataStructure.NotEmptyConstraint()]) }, [])], []) }));

export const renderedOrderEntityDataStructure = orderEntityDataStructure;"
`;
