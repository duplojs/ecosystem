exports[`lazyStructureTransformer > renders a recursive catalog tree with nested lazy structures 1`] = `
"import * as DDataStructure from "@duplojs/lang/dataStructure";

import * as DString from "@duplojs/lang/string";

import * as DPath from "@duplojs/lang/path";

export type CatalogFacet = {
    readonly name: string & DString.NotEmpty;
    readonly children: readonly CatalogFacet[];
};

export type $catalogFacetStructure = CatalogFacet;

export type CatalogCategory = {
    readonly slug: string & DPath.Segment;
    readonly parent: null | CatalogCategory;
    readonly facets: readonly CatalogFacet[];
    readonly children: readonly CatalogCategory[];
};

export type $catalogCategoryStructure = CatalogCategory;

export const catalogFacetStructure: DDataStructure.Structure<$catalogFacetStructure> = DDataStructure.ObjectStructure({
    name: DDataStructure.TypeStructure(DDataStructure.StringType(), [
        DDataStructure.NotEmptyConstraint()
    ]),
    children: DDataStructure.ArrayStructure(DDataStructure.LazyStructure(() => catalogFacetStructure, []), [])
}, []);

export const catalogCategoryStructure: DDataStructure.Structure<$catalogCategoryStructure> = DDataStructure.ObjectStructure({
    slug: DDataStructure.TypeStructure(DDataStructure.StringType(), [
        DDataStructure.SegmentPathConstraint()
    ]),
    parent: DDataStructure.UnionStructure([
        DDataStructure.TypeStructure(DDataStructure.NullType(), []),
        catalogCategoryStructure
    ], []),
    facets: DDataStructure.ArrayStructure(DDataStructure.LazyStructure(() => catalogFacetStructure, []), []),
    children: DDataStructure.ArrayStructure(DDataStructure.LazyStructure(() => catalogCategoryStructure, []), [])
}, []);

export const renderedCatalogCategoryStructure = catalogCategoryStructure;"
`;
