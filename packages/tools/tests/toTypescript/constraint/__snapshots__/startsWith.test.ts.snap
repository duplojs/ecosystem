exports[`startsWithConstraintTransformer > renders a literal 1`] = `"export type ResourcePath = string & \`asset:\${string}\`;"`;

exports[`startsWithConstraintTransformer > renders an empty literal 1`] = `"export type ResourcePath = string & \`\${string}\`;"`;

exports[`startsWithConstraintTransformer > renders an escaped literal 1`] = `
"export type ResourcePath = string & \`\\\` \\\${value} \\\\ " \\u00E9\\uD83D\\uDE00
\${string}\`;"
`;

exports[`startsWithConstraintTransformer > renders combined string constraints 1`] = `"export type ResourcePath = string & \`asset:\${string}\` & \`\${string}.json\` & \`\${string}/lang/\${string}\`;"`;
