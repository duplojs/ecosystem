{
  "name": "@duplojs/lang",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "DuploJS",
    "url": "https://github.com/duplojs"
  },
  "description": "Type-driven language layer for TypeScript: immutable, pipeable functions, Either, and constrained primitives.",
  "homepage": "https://lang.duplojs.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duplojs/lang.git"
  },
  "scripts": {
    "build": "./.commands/build.sh",
    "test:ut": "./.commands/test-ut.sh",
    "test:ut:watch": "./.commands/test-ut.sh --watch",
    "test:ut:update": "./.commands/test-ut.sh --update",
    "test:types": "./.commands/test-types.sh",
    "test:types:target": "./.commands/test-types-target.sh",
    "test:lint": "./.commands/test-lint.sh",
    "test:lint:fix": "./.commands/test-lint.sh --fix"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common/index.mjs",
      "require": "./dist/common/index.cjs",
      "types": "./dist/common/index.d.ts"
    },
    "./kind": {
      "import": "./dist/kind/index.mjs",
      "require": "./dist/kind/index.cjs",
      "types": "./dist/kind/index.d.ts"
    },
    "./object": {
      "import": "./dist/object/index.mjs",
      "require": "./dist/object/index.cjs",
      "types": "./dist/object/index.d.ts"
    },
    "./string": {
      "import": "./dist/string/index.mjs",
      "require": "./dist/string/index.cjs",
      "types": "./dist/string/index.d.ts"
    },
    "./either": {
      "import": "./dist/either/index.mjs",
      "require": "./dist/either/index.cjs",
      "types": "./dist/either/index.d.ts"
    },
    "./dataStructure": {
      "import": "./dist/dataStructure/index.mjs",
      "require": "./dist/dataStructure/index.cjs",
      "types": "./dist/dataStructure/index.d.ts"
    },
    "./array": {
      "import": "./dist/array/index.mjs",
      "require": "./dist/array/index.cjs",
      "types": "./dist/array/index.d.ts"
    },
    "./chrono": {
      "import": "./dist/chrono/index.mjs",
      "require": "./dist/chrono/index.cjs",
      "types": "./dist/chrono/index.d.ts"
    },
    "./tuple": {
      "import": "./dist/tuple/index.mjs",
      "require": "./dist/tuple/index.cjs",
      "types": "./dist/tuple/index.d.ts"
    },
    "./number": {
      "import": "./dist/number/index.mjs",
      "require": "./dist/number/index.cjs",
      "types": "./dist/number/index.d.ts"
    },
    "./modeling": {
      "import": "./dist/modeling/index.mjs",
      "require": "./dist/modeling/index.cjs",
      "types": "./dist/modeling/index.d.ts"
    },
    "./pattern": {
      "import": "./dist/pattern/index.mjs",
      "require": "./dist/pattern/index.cjs",
      "types": "./dist/pattern/index.d.ts"
    },
    "./generator": {
      "import": "./dist/generator/index.mjs",
      "require": "./dist/generator/index.cjs",
      "types": "./dist/generator/index.d.ts"
    },
    "./invocation": {
      "import": "./dist/invocation/index.mjs",
      "require": "./dist/invocation/index.cjs",
      "types": "./dist/invocation/index.d.ts"
    },
    "./path": {
      "import": "./dist/path/index.mjs",
      "require": "./dist/path/index.cjs",
      "types": "./dist/path/index.d.ts"
    },
    "./printer": {
      "import": "./dist/printer/index.mjs",
      "require": "./dist/printer/index.cjs",
      "types": "./dist/printer/index.d.ts"
    }
  },
  "devDependencies": {
    "@duplojs/code-config": "workspace:*",
    "@types/node": "24.1.0"
  },
  "files": [
    "dist",
    "README"
  ],
  "keywords": [
    "typescript",
    "lang",
    "functional-programming",
    "immutable",
    "pipe",
    "curry",
    "data-checker",
    "either-utils",
    "array-utils",
    "object-utils",
    "string-utils",
    "number-utils",
    "date-utils",
    "modeling-ddd",
    "pattern-matching",
    "constrained-types",
    "duplojs"
  ]
}
