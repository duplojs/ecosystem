			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"dependencies": {
		"@duplojs/lang": "workspace:*",
		"@duplojs/server": "workspace:*"
	},
	"peerDependencies": {
		"@duplojs/code-config": "workspace:*",
		"@duplojs/eslint": "workspace:*",
		"@duplojs/form": "workspace:*",
		"@duplojs/http": "workspace:*",
		"@duplojs/json-web-token": "workspace:*",
		"@duplojs/lang": "workspace:*",
		"@duplojs/playwright": "workspace:*",
		"@duplojs/server": "workspace:*",
		"@duplojs/tools": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@duplojs/code-config": {
			"optional": true
		},
		"@duplojs/eslint": {
			"optional": true
		},
		"@duplojs/form": {
			"optional": true
		},
		"@duplojs/http": {
			"optional": true
		},
		"@duplojs/json-web-token": {
			"optional": true
		},
		"@duplojs/playwright": {
			"optional": true
		},
		"@duplojs/tools": {
			"optional": true
		}
	},
	"devDependencies": {
		"@duplojs/code-config": "workspace:*",
    "@types/node": "24.13.3"
	},
	"files": [
		"dist",
    "skills",
		"README.md"
	],
	"keywords": [
		"duplojs",
		"skills"
	],
	"engines": {
		"node": ">=24.18.0"
	}
